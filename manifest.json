{
  "manifest_version": 3,
  "name": "Allegro + Ceneo + OLX Offer Exporter for ChatGPT",
  "version": "1.7.0",
  "description": "Eksportuje Allegro, Ceneo i OLX w tle, zapisuje checkpointy, bezpiecznie wznawia zadania i ogranicza tempo Allegro po wykryciu ochrony.",
  "permissions": [
    "tabs",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://allegro.pl/*",
    "https://*.allegro.pl/*",
    "https://ceneo.pl/*",
    "https://*.ceneo.pl/*",
    "https://olx.pl/*",
    "https://*.olx.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Eksportuj Allegro / Ceneo / OLX",
    "default_popup": "popup.html"
  }
}
